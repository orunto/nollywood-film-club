{
  "extends": "./tsconfig.react-router.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": [
    ".react-router/types/**/*",
    "src/app/**/*",
    "src/db/**/*",
    "src/runtime/**/*",
    "src/repositories/**/*",
