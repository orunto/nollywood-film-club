# Better Auth (new runtime)
# Base URL where authentication is mounted; default localhost differs per runtime.
AUTH_URL=http://localhost:3000
# Secret for signing/hashing auth tokens. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=
# OAuth provider credentials. Providers are only enabled when both are set.
# For wrangler dev, set these as `wrangler secret put <NAME>`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Portable service adapters used by both runtimes.
# The mail endpoint accepts { from, to, subject, text } JSON with bearer auth.
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=
# Node uses this endpoint for image transformations (imgproxy or an equivalent
# internal service). Cloudflare uses its Images binding when this is omitted.
IMAGE_TRANSFORMER_URL=
IMAGE_TRANSFORMER_API_KEY=

# Migration-only source credentials. Never configure these in the application
# runtime or production Worker.
DATABASE_URL=
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
