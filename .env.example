# Neon Postgres connection string (used by Drizzle ORM and drizzle-kit)
# Get it from https://console.neon.tech -> your project -> Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Hexclave (https://app.hexclave.com -> your project -> API Keys)
# Read automatically by @stackframe/stack — see stack.tsx
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Cloudinary (https://console.cloudinary.com -> Dashboard)
# Used by next-cloudinary's CldImage to render poster/review images
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Required for admin image uploads (signing + JustWatch poster imports).
# Server-only - must be set in the deployment environment too, not just locally.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Better Auth (new runtime)
# Base URL where authentication is mounted; default localhost differs per runtime.
AUTH_URL=http://localhost:3000
# Secret for signing/hashing auth tokens. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=
# OAuth provider credentials. Providers are only enabled when both are set.
# For wrangler dev, set these as `wrangler secret put <NAME>`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
