{
  "name": "nollywood-film-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --mode cloudflare",
    "dev:node": "cross-env NODE_ENV=development node --conditions development server.js",
    "build": "bun run build:cloudflare",
    "build:cloudflare": "react-router build --mode cloudflare",
    "build:node": "react-router build --mode node",
    "start": "node server.js",
    "cf-typegen": "wrangler types --env-file wrangler.types.env && react-router typegen",
    "check:new-runtime": "bun run cf-typegen && tsc -p tsconfig.cloudflare.json && tsc -p tsconfig.node-runtime.json && bun run build:cloudflare && wrangler deploy --dry-run",
    "lint": "eslint .",
    "migration:introspect-neon": "tsx tools/migration/introspect-neon.ts",
    "migration:export-neon": "tsx tools/migration/export-neon.ts",
    "migration:export-hexclave": "tsx tools/migration/export-hexclave.ts",
    "migration:inventory-cloudinary": "tsx tools/migration/inventory-cloudinary.ts",
    "migration:copy-cloudinary": "tsx tools/migration/copy-cloudinary-assets.ts",
    "migration:import-hexclave-users": "tsx tools/migration/import-hexclave-users.ts",
    "migration:export": "bun run migration:export-neon && bun run migration:export-hexclave",
    "migration:generate-sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "migration:transform-sqlite": "tsx tools/migration/transform-sqlite.ts",
    "migration:validate-sqlite": "tsx tools/migration/validate-sqlite.ts",
    "migration:load-local-d1": "tsx tools/migration/load-local-d1.ts",
    "migration:validate-import": "tsx tools/migration/validate-import.ts",
    "migration:restore-sqlite": "tsx tools/migration/restore-sqlite.ts",
    "migration:copy-objects": "tsx tools/migration/copy-objects.ts",
    "migration:seed-r2": "tsx tools/migration/seed-r2.ts",
    "migration:backfill-opengraph": "tsx tools/migration/backfill-opengraph.ts",
    "test:characterization": "playwright test",
    "test:runtime": "bun run test:runtime:cloudflare && bun run test:runtime:node",
    "test:runtime:cloudflare": "cross-env RUNTIME_TARGET=cloudflare playwright test --config playwright.runtime.config.ts",
    "test:runtime:node": "bun run build:node && cross-env RUNTIME_TARGET=node playwright test --config playwright.runtime.config.ts",
    "test:repositories": "tsx --test tests/**/*.test.ts",
    "validate:public-reads": "tsx tools/repositories/validate-public-reads.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/express": "8.3.0",
    "@react-router/node": "8.3.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-query": "^5.87.1",
    "@tiptap/extension-character-count": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "better-auth": "1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "1.8.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "embla-carousel-react": "^8.6.0",
    "express": "5.2.1",
    "input-otp": "^1.4.2",
    "isbot": "5.1.36",
    "lucide-react": "^0.539.0",
    "morgan": "1.10.1",
    "react": "19.2.1",
    "react-day-picker": "^9.8.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^3.0.4",
    "react-router": "8.3.0",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tiptap-markdown": "^0.9.0",
    "vaul": "^1.1.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@stackframe/stack": "^2.8.28",
    "@cloudflare/vite-plugin": "1.52.1",
    "@playwright/test": "^1.54.2",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.2.2",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.20.4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
